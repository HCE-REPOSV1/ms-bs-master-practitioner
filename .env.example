# ms-bs-practitioner-service — Environment Variables
# Generated by Jarvis Platform

PORT=10405
NODE_ENV=production

# HTTPS (certificado autofirmado de prueba en ./certs-dev, montado en CERT_PATH via docker-compose.dev.yml)
USE_SSL=true
SSL_PORT=20405
CERT_PATH=/app/certs

# Database (SQL Server)
# IMPORTANTE: En producción estas variables deben venir del runtime,
# NO del archivo .env. Usar K8s Secrets, Azure Key Vault, etc.
DB_HOST=host.docker.internal
DB_PORT=1433
DB_USER=claude_mssql
DB_PASS=1234
DB_NAME=HCE_CORE_V2

# Kafka Logger
AUDIT_LOGGER_ENABLED=true
KAFKA_BROKER=host.docker.internal:10403
#KAFKA_BROKER=192.168.42.44:10403
KAFKA_TOPIC=platform.logs
CERTS_HOST_PATH=../certs-dev
